<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BusinessOwnerProfileActivity">

    <!-- Restaurant Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/create_profile_background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Dark Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6101615" />

    <!-- Scroll View -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="35dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:text="CREATE BUSINESS PROFILE"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="#9DE7DF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Step 1 of 2: Owner Details"
                android:fontFamily="@font/poppins_regular"
                android:textColor="#E8F5F4"
                android:textSize="14sp" />

            <!-- Profile Photo -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp">

                <ImageView
                    android:id="@+id/ownerProfileImage"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/profile_placeholder"
                    android:scaleType="centerCrop"
                    android:background="@drawable/profile_photo_circle"
                    android:clipToOutline="true"
                    android:contentDescription="Profile photo" />

            </FrameLayout>

            <Button
                android:id="@+id/btnUploadOwnerPhoto"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="Upload Photo"
                android:textAllCaps="false"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="#263838"
                android:textSize="13sp"
                android:background="@drawable/upload_photo_button" />

            <!-- Full Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/ownerNameInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Enter your full name"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B8C5C4"
                    android:textSize="14sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:background="@drawable/profile_input_field"
                    android:inputType="textPersonName" />

            </LinearLayout>

            <!-- Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/ownerEmailInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Enter email address"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B8C5C4"
                    android:textSize="14sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:background="@drawable/profile_input_field"
                    android:inputType="textEmailAddress" />

            </LinearLayout>

            <!-- Phone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Phone"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/ownerPhoneInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Enter phone number"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B8C5C4"
                    android:textSize="14sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:background="@drawable/profile_input_field"
                    android:inputType="phone"
                    android:maxLength="10" />

            </LinearLayout>

            <!-- DOB -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="DOB"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/ownerDobInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Select date of birth"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B8C5C4"
                    android:textSize="14sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:background="@drawable/profile_input_field"
                    android:focusable="false"
                    android:clickable="true" />

            </LinearLayout>

            <!-- Password -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/ownerPasswordInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Enter password"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B8C5C4"
                    android:textSize="14sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:background="@drawable/profile_input_field"
                    android:inputType="textPassword"
                    android:drawableEnd="@android:drawable/ic_menu_view"
                    android:drawablePadding="8dp" />

            </LinearLayout>

            <!-- Next Button -->
            <Button
                android:id="@+id/btnNextRestaurantDetails"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:text="Next: Restaurant Details"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="#17211D"
                android:enabled="false"
                android:background="@drawable/profile_continue_button"
                android:backgroundTint="@null" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>