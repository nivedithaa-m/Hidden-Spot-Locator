<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreateProfileActivity">

    <!-- Scenic background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/create_profile_background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Dark transparent overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="60dp"
            android:paddingBottom="40dp">

            <!-- Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREATE PROFILE"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="#9DE7DF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Choose how you want to explore Hidden Spot Locator"
                android:fontFamily="@font/poppins_regular"
                android:textColor="#E8F5F4"
                android:textSize="13sp"
                android:gravity="center" />

            <!-- Traveller Card -->
            <LinearLayout
                android:id="@+id/travellerCard"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="55dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/profile_role_card"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I'M A TRAVELLER"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#F2D6A2"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Discover hidden spots, explore new places and plan your journey"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#D8E2E1"
                    android:textSize="13sp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Business Card -->
            <LinearLayout
                android:id="@+id/businessCard"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="25dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/profile_role_card"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I'M A BUSINESS OWNER"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#F2D6A2"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Showcase your restaurant along with menus and reach more visitors"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#D8E2E1"
                    android:textSize="13sp"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>
    <Button
        android:id="@+id/continueButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="30dp"
        android:text="Continue"
        android:textAllCaps="false"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:enabled="false"
        android:background="@drawable/profile_continue_button"
        android:backgroundTint="@null"/>


</FrameLayout>