<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mapRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101615"
    tools:context=".MapRouteActivity">

    <!-- OpenStreetMap View -->
    <org.osmdroid.views.MapView
        android:id="@+id/osmMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Floating Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardBackgroundColor="#182220"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnMapBack"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:src="@drawable/ic_navigation"
                        android:rotation="270"
                        app:tint="#9DE7DF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMapRouteTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Start ➔ Destination"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="@font/fraunces_bold" />

                        <TextView
                            android:id="@+id/tvMapRouteSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Optimal route via OpenStreetMap"
                            android:textColor="#B8C5C4"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTravelModeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/home_icon_circle"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="🚗 Driving"
                        android:textColor="#17211D"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_medium" />
                </LinearLayout>

                <!-- Stats Divider line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#2C3B38" />

                <!-- Route Stats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DISTANCE"
                            android:textColor="#9AA9A5"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_medium" />

                        <TextView
                            android:id="@+id/tvTotalDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14.2 km"
                            android:textColor="#9DE7DF"
                            android:textSize="16sp"
                            android:fontFamily="@font/inter_medium" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="#2C3B38" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EST. TIME"
                            android:textColor="#9AA9A5"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_medium" />

                        <TextView
                            android:id="@+id/tvEstTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="26 mins"
                            android:textColor="#4ADE80"
                            android:textSize="16sp"
                            android:fontFamily="@font/inter_medium" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="#2C3B38" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TRAFFIC"
                            android:textColor="#9AA9A5"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clear Route"
                            android:textColor="#FBBF24"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_medium" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Journey Controls (Start / End Journey) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <!-- Start Journey Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnStartJourney"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/home_icon_circle"
                        android:backgroundTint="#22C55E"
                        android:text="🚀 Start Journey Navigation"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_medium" />

                    <!-- End Journey Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnEndJourney"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/home_icon_circle"
                        android:backgroundTint="#EF4444"
                        android:text="🛑 End Active Journey"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:visibility="gone"
                        android:fontFamily="@font/inter_medium" />
                </FrameLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Off-Route Notification Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardOffRouteBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="210dp"
        android:visibility="gone"
        app:cardBackgroundColor="#7F1D1D"
        app:cardCornerRadius="14dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvOffRouteText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚠️ Off route detected"
                android:textColor="#FEE2E2"
                android:textSize="13sp"
                android:fontFamily="@font/inter_medium" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRecalculateRoute"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/home_icon_circle"
                android:backgroundTint="#DC2626"
                android:paddingHorizontal="12dp"
                android:text="Recalculate 🔄"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/inter_medium" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Floating Buttons on Right/Top -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Radar Toggle Button -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnToggleRadar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Radar: ON"
            android:textColor="#17211D"
            app:backgroundTint="#9DE7DF"
            app:icon="@drawable/ic_radar"
            app:iconTint="#17211D" />

        <!-- Recenter Map Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnRecenterMap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:contentDescription="Recenter Map"
            app:backgroundTint="#182220"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_my_location"
            app:tint="#9DE7DF" />
    </LinearLayout>

    <!-- Radar Controls Overlay Panel -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRadarControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="220dp"
        app:cardBackgroundColor="#182220"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_radar"
                    app:tint="#9DE7DF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Nearby Radar Distance"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_medium" />

                <TextView
                    android:id="@+id/tvRadarRadiusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_icon_circle"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="2.5 km"
                    android:textColor="#17211D"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_medium" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderRadarDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="2.5"
                android:valueFrom="0.5"
                android:valueTo="10.0"
                app:haloColor="#339DE7DF"
                app:thumbColor="#9DE7DF"
                app:trackColorActive="#9DE7DF"
                app:trackColorInactive="#2C3B38" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupRadius"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRad1"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 km"
                        android:textColor="#E2E8F0" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRad25"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="2.5 km"
                        android:textColor="#E2E8F0" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRad5"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 km"
                        android:textColor="#E2E8F0" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRad10"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 km"
                        android:textColor="#E2E8F0" />
                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

            <TextView
                android:id="@+id/tvRadarStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Scanning nearby restaurants &amp; places within 2.5 km..."
                android:textColor="#9AA9A5"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Sheet / Nearby Places List -->
    <LinearLayout
        android:id="@+id/bottomSheetNearby"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="12dp"
        android:orientation="vertical">

        <!-- Bottom Sheet Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="#2C3B38" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvNearbyPlacesHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nearby Food &amp; Spots (Radar)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/fraunces_bold" />

            <TextView
                android:id="@+id/tvPlaceCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/home_icon_circle"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="6 found"
                android:textColor="#17211D"
                android:textSize="12sp"
                android:fontFamily="@font/inter_medium" />
        </LinearLayout>

        <!-- Filter category horizontal scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="All Places" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterFood"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍔 Restaurants" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterCafe"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☕ Cafes" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterGas"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛽ Fuel" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterSpot"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏰 Tourist Spots" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Recycler View of nearby places -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNearbyPlaces"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            tools:listitem="@layout/item_nearby_place" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>