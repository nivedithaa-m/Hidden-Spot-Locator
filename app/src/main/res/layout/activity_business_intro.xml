<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/businessWelcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101615"
    tools:context=".BusinessIntroActivity">

    <!-- Background Image Switcher -->
    <ImageSwitcher
        android:id="@+id/businessBackgroundSwitcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dark Overlays -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/welcome_overlay" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_bottom_overlay" />

    <!-- Content Container -->
    <LinearLayout
        android:id="@+id/slideContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="52dp"
        android:paddingBottom="40dp">

        <!-- Top Header -->
        <TextView
            android:id="@+id/tvHeaderCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BUSINESS PARTNER • 01 / 04"
            android:fontFamily="@font/fraunces_semibold"
            android:textColor="#F2D6A2"
            android:textSize="12sp"
            android:letterSpacing="0.14" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Feature Showcase Card -->
        <LinearLayout
            android:id="@+id/showcaseCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/traveller_intro_card"
            android:orientation="vertical"
            android:padding="26dp">

            <!-- Step badge -->
            <TextView
                android:id="@+id/tvStepBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/traveller_icon_background"
                android:fontFamily="@font/inter_medium"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="FEATURE 01"
                android:textColor="#9DE7DF"
                android:textSize="11sp" />

            <!-- Category -->
            <TextView
                android:id="@+id/tvFeatureCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="SHOWCASE MENU &amp; DAILY SPECIALS"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="#9DE7DF"
                android:textSize="12sp"
                android:letterSpacing="0.08" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvSlideTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Reach Hungry Travelers Nearby"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:fontFamily="@font/fraunces_bold" />

            <!-- Description -->
            <TextView
                android:id="@+id/tvSlideDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Highlight your signature dishes, daily lunch specials, and complete menu with transparent pricing directly to travelers exploring your route."
                android:textColor="#D0DEDB"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/inter_regular" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Dots Indicator -->
        <LinearLayout
            android:id="@+id/dotsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/dot0"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/dot_active" />

            <View
                android:id="@+id/dot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/dot_inactive" />

            <View
                android:id="@+id/dot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/dot_inactive" />

            <View
                android:id="@+id/dot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_inactive" />

        </LinearLayout>

        <!-- Tap Anywhere Hint -->
        <TextView
            android:id="@+id/tapAnywhereHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Tap anywhere to continue ›"
            android:fontFamily="@font/inter_regular"
            android:textColor="#F2D6A2"
            android:textSize="13sp"
            android:letterSpacing="0.03" />

    </LinearLayout>

</FrameLayout>