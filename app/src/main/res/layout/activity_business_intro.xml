<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101615"
    tools:context=".BusinessIntroActivity">

    <!-- Background -->
    <ImageView
        android:id="@+id/businessBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/forest2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Dark overlay -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A6101615"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Centre card -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/businessScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/traveller_intro_card"
            android:orientation="vertical"
            android:paddingStart="25dp"
            android:paddingTop="28dp"
            android:paddingEnd="25dp"
            android:paddingBottom="22dp">

            <!-- Section label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fraunces_bold"
                android:letterSpacing="0.01"
                android:text="BUSINESS"
                android:textColor="#FFFFFF"
                android:textSize="38sp" />

            <!-- Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_medium"
                android:text="Promote your local business."
                android:textColor="#9DE7DF"
                android:textSize="16sp" />

            <!-- Intro -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_regular"
                android:lineSpacingExtra="3dp"
                android:text="Hidden Spot Locator connects travellers with authentic local restaurants, cafes, and spots in Kollam. Present your business to thousands of explorers."
                android:textColor="#D0DEDB"
                android:textSize="14sp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#35413E" />

            <!-- Feature 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/traveller_icon_background"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="01"
                    android:textColor="#9DE7DF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"
                    android:text="Showcase your restaurant or local spot"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Feature 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/traveller_icon_background"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="02"
                    android:textColor="#9DE7DF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"
                    android:text="Display menu items, specialties &amp; prices"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Feature 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/traveller_icon_background"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="03"
                    android:textColor="#9DE7DF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"
                    android:text="Reach travellers searching along their route"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Continue -->
            <Button
                android:id="@+id/btnBusinessContinue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="23dp"
                android:background="@drawable/traveller_continue_button"
                android:fontFamily="@font/inter_medium"
                android:text="Continue to Business Profile"
                android:textAllCaps="false"
                android:textColor="#10201D"
                android:textSize="15sp" />

            <!-- Skip -->
            <TextView
                android:id="@+id/tvBusinessSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="9dp"
                android:fontFamily="@font/inter_regular"
                android:padding="7dp"
                android:text="Skip &amp; Explore as Guest"
                android:textColor="#91A19C"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>