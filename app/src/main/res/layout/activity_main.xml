<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hidden_spot_locator"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Dark overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/welcome_overlay" />

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="40dp"
        android:paddingBottom="30dp">

        <!-- Space above heading -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- App heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HIDDEN SPOT"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="LOCATOR"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#9DE7DF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.20"
            android:gravity="center" />

        <!-- Small gap -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="18dp" />

        <!-- Main tagline -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Discover the places that don't always make the map."
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
             />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Explore hidden gems, taste local flavours, and find unforgettable stops along your journey."
            android:fontFamily="@font/poppins_regular"
            android:textColor="#E8F5F4"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <!-- Space between content and buttons -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Create Profile button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/createProfileButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Create Profile"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/welcome_button" />
        <!-- Login button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Login"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/welcome_login_button" />
    </LinearLayout>

</FrameLayout>