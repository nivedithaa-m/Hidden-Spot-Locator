<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/traveller_profile_background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Dark overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="35dp">

            <!-- Page heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:text="CREATE TRAVELLER PROFILE"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="#9DE7DF"
                android:textSize="27sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Tell us a little about yourself"
                android:fontFamily="@font/poppins_regular"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- Profile Photo -->

            <FrameLayout
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp">

                <!-- Photo circle -->
                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:src="@drawable/profile_placeholder"
                    android:scaleType="centerCrop"
                    android:background="@drawable/profile_photo_circle"
                    android:clipToOutline="true"
                    android:contentDescription="Profile photo" />

            </FrameLayout>

            <!-- Upload Photo Button -->
            <Button
                android:id="@+id/uploadPhotoButton"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="Upload Photo"
                android:textAllCaps="false"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="#263838"
                android:textSize="13sp"
                android:background="@drawable/upload_photo_button" />
            <!-- Full Name -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/nameInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Enter your full name"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B8C5C4"
                    android:textSize="14sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:background="@drawable/profile_input_field"
                    android:inputType="textPersonName" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/emailInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Enter your email"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B8C5C4"
                    android:textSize="14sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:background="@drawable/profile_input_field"
                    android:inputType="textEmailAddress" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Phone"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/phoneInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Enter phone number"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B8C5C4"
                    android:textSize="14sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:background="@drawable/profile_input_field"
                    android:inputType="phone"
                    android:maxLength="10"/>

            </LinearLayout>
            <!-- Date of Birth -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="DOB"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/dobInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Select your date of birth"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B8C5C4"
                    android:textSize="14sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:background="@drawable/profile_input_field"
                    android:focusable="false"
                    android:clickable="true" />

            </LinearLayout>
            <!-- Password -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Enter your password"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B8C5C4"
                    android:textSize="14sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:background="@drawable/profile_input_field"
                    android:inputType="textPassword"
                    android:drawableEnd="@android:drawable/ic_menu_view"
                    android:drawablePadding="8dp" />

            </LinearLayout>
            <!-- Create Profile Button -->
            <Button
                android:id="@+id/createProfileButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:text="Create Profile"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="#FFFFFF"
                android:enabled="false"
                android:background="@drawable/profile_continue_button"
                android:backgroundTint="@null"/>/>

        </LinearLayout>

    </ScrollView>

</FrameLayout>