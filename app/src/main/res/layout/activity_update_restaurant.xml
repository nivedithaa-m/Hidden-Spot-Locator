<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101615"
    tools:context=".UpdateRestaurantActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/road" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9101615" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp"
            android:paddingBottom="35dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="UPDATE / RELOCATION NOTICE"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:text="Submit relocation address, detail changes, or closure notes for admin review."
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!-- Request Type Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="REQUEST TYPE"
                android:textColor="#9DE7DF"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgRequestType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/rbUpdateDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="@font/poppins_regular"
                    android:text="✏️ Update Menu, Prices, Hours, or Contact"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbRelocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="📍 Report Proposed Relocation"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbClosure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="🛑 Report Permanent Closure"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </RadioGroup>

            <!-- Proposal Details / Reason Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="PROPOSED DETAILS / REASON"
                android:textColor="#9DE7DF"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etUpdateDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:background="@drawable/profile_input_field"
                android:fontFamily="@font/poppins_regular"
                android:gravity="top"
                android:hint="Provide details (e.g. proposed new address in Kollam, updated prices, or closure notes)"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="4"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#B8C5C4"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSubmitUpdateRequest"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/profile_continue_button"
                android:backgroundTint="@null"
                android:fontFamily="@font/poppins_semibold"
                android:text="Submit Request for Admin Approval ➔"
                android:textAllCaps="false"
                android:textColor="#17211D"
                android:textSize="15sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar for Business -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/home_bottom_nav"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/bizNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#899995"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Home"
                android:textColor="#899995"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Add -->
        <LinearLayout
            android:id="@+id/bizNavAdd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#899995"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Add"
                android:textColor="#899995"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Update (Highlighted) -->
        <LinearLayout
            android:id="@+id/bizNavUpdate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✏️"
                android:textColor="#9DE7DF"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_medium"
                android:text="Update"
                android:textColor="#9DE7DF"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/bizNavProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○"
                android:textColor="#899995"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Profile"
                android:textColor="#899995"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>