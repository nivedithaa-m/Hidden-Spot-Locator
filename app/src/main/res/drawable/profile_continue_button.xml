<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E5D8C0" />

            <corners android:radius="20dp" />

            <stroke
                android:width="2dp"
                android:color="#E5D8C0" />
        </shape>
    </item>

    <!-- Disabled -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#554A5555" />

            <corners android:radius="20dp" />

            <stroke
                android:width="1dp"
                android:color="#77808080" />
        </shape>
    </item>

    <!-- Enabled -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F1E6D0" />

            <corners android:radius="20dp" />

            <stroke
                android:width="2dp"
                android:color="#F1E6D0" />
        </shape>
    </item>

</selector>